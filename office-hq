#!/usr/bin/env python3
"""office-hq — localhost dashboard for /office agents.

Serves a sepia pixel-office page showing every running agent (desk, task, live
action, elapsed) plus the recent runs feed. Reads the same state files as the
statusline and office-watch: ~/.claude/office-logs/active/*.json + runs.jsonl.

Usage:  office-hq [--port 4545]        (foreground)
        office-hq --daemon             (background, prints URL, exits)
Stop:   office-hq --stop
The /office skill starts it automatically when the mode is activated.
"""

import json, os, sys, time, glob, subprocess, signal, socket
from http.server import HTTPServer, BaseHTTPRequestHandler

PORT = int(sys.argv[sys.argv.index("--port") + 1]) if "--port" in sys.argv else 4545
LOG_DIR = os.path.expanduser("~/.claude/office-logs")
ACTIVE_DIR = os.path.join(LOG_DIR, "active")
RUNS = os.path.join(LOG_DIR, "runs.jsonl")
PIDFILE = os.path.join(LOG_DIR, "office-hq.pid")

ROSTER = [
    ("lead",  "tnk", "Tanaka", "qwen3.8-max-preview"),
    ("ds",    "suz", "Suzuki", "deepseek-v4-flash-0731"),
    ("glm",   "ken", "Kenji",  "glm-5.2"),
    ("k2",    "yuk", "Yuki",   "kimi-for-coding"),
    ("flash", "hay", "Hayate", "qwen3.6-flash"),
]

def pid_alive(pid):
    try:
        os.kill(pid, 0); return True
    except Exception:
        return False

def claude_ancestor(pid):
    p = pid
    for _ in range(10):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(p)],
                                 capture_output=True, text=True, timeout=2).stdout.strip()
            if not out: return 0
            ppid_s, _, comm = out.partition(" ")
            p = int(ppid_s.strip())
        except Exception:
            return 0
        if p <= 1: return 0
        if "claude" in comm.strip().rsplit("/", 1)[-1]: return p
    return 0

def state():
    agents = []
    for f in glob.glob(os.path.join(ACTIVE_DIR, "*.json")):
        try: d = json.load(open(f))
        except Exception: continue
        pid = int(d.get("pid") or 0)
        if not pid or not pid_alive(pid): continue
        d["boss"] = int(d.get("boss") or 0) or claude_ancestor(pid)
        agents.append(d)
    recent = []
    try:
        lines = open(RUNS).readlines()[-12:]
        for ln in reversed(lines):
            try: recent.append(json.loads(ln))
            except Exception: pass
    except Exception:
        pass
    return {"agents": agents, "recent": recent, "roster": ROSTER, "now": int(time.time())}

PAGE = """<!doctype html><html><head><meta charset="utf-8"><title>OFFICE HQ</title>
