class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        if self.path.startswith("/api/state"):
            body = json.dumps(state()).encode()
            ct = "application/json"
        elif self.path == "/health":
            body, ct = b"ok", "text/plain"
        else:
            body, ct = PAGE.encode(), "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", ct)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

def main():
    if "--stop" in sys.argv:
        try:
            pid = int(open(PIDFILE).read().strip())
            os.kill(pid, signal.SIGTERM)
            print(f"office-hq: stopped (pid {pid})")
        except Exception:
            print("office-hq: not running")
        return
    # already up?
    try:
        s = socket.create_connection(("127.0.0.1", PORT), timeout=1); s.close()
        print(f"office-hq: already running — http://localhost:{PORT}")
        return
    except Exception:
        pass
    if "--daemon" in sys.argv:
        args = [a for a in sys.argv[1:] if a != "--daemon"]
        subprocess.Popen([sys.executable, os.path.abspath(__file__)] + args,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        print(f"office-hq: http://localhost:{PORT}")
        return
    os.makedirs(LOG_DIR, exist_ok=True)
    open(PIDFILE, "w").write(str(os.getpid()))
    srv = HTTPServer(("127.0.0.1", PORT), H)
    try:
        srv.serve_forever()
    finally:
        try: os.remove(PIDFILE)
        except Exception: pass

if __name__ == "__main__":
    main()
